generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  VENDEDOR
  PREVENTA
  GERENTE
  OPERACIONES
  PROGRAMADOR
  SUPERVISOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum OpportunityStage {
  PROSPECTO
  CALIFICACION
  PROPUESTA
  NEGOCIACION
  GANADA
  PERDIDA
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------------------------------------------
// Usuarios, sesiones y auditoría
// ---------------------------------------------------------------------------

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String           @db.VarChar(120)
  email              String           @unique @db.VarChar(255)
  passwordHash       String?          @map("password_hash") @db.VarChar(255)
  role               Role             @default(VENDEDOR)
  status             UserStatus       @default(ACTIVE)
  avatarUrl          String?          @map("avatar_url") @db.VarChar(500)
  googleId           String?          @unique @map("google_id") @db.VarChar(255)
  themePreference    ThemePreference  @default(SYSTEM) @map("theme_preference")
  mustChangePassword Boolean          @default(false) @map("must_change_password")
  lastLoginAt        DateTime?        @map("last_login_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  sessions         Session[]
  createdCompanies Company[]       @relation("CompanyCreatedBy")
  opportunities    Opportunity[]   @relation("OpportunityOwner")
  sales            Sale[]          @relation("SaleOwner")
  managedProjects  Project[]       @relation("ProjectManager")
  assignedTasks    ProjectTask[]   @relation("TaskAssignee")
  uploadedFiles    ProjectFile[]   @relation("FileUploader")
  projectComments  ProjectComment[] @relation("ProjectCommentAuthor")
  opportunityFiles OpportunityFile[] @relation("OpportunityFileUploader")
  opportunityComments OpportunityComment[] @relation("OpportunityCommentAuthor")
  activityLogs     ActivityLog[]
  avatar           UserAvatar?

  @@index([role])
  @@index([status])
  @@map("users")
}

/// Imagen de perfil guardada en PostgreSQL (el disco de Render es efímero).
/// Va en su propia tabla para no cargar el binario en cada consulta de User.
model UserAvatar {
  userId    String   @id @map("user_id") @db.Uuid
  mimeType  String   @map("mime_type") @db.VarChar(50)
  data      Bytes    @db.ByteA
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  csrfToken  String   @map("csrf_token") @db.VarChar(64)
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at")
  rememberMe Boolean  @default(false) @map("remember_me")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(40)
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.Uuid
  description String   @db.VarChar(300)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Datos comerciales
// ---------------------------------------------------------------------------

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(160)
  legalName   String?       @map("legal_name") @db.VarChar(200)
  taxId       String?       @unique @map("tax_id") @db.VarChar(40)
  sector      String?       @db.VarChar(100)
  email       String?       @db.VarChar(255)
  phone       String?       @db.VarChar(40)
  address     String?       @db.VarChar(300)
  website     String?       @db.VarChar(300)
  status      CompanyStatus @default(ACTIVE)
  notes       String?       @db.Text
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy     User?         @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  clients       Client[]
  opportunities Opportunity[]
  sales         Sale[]
  projects      Project[]

  @@index([name])
  @@index([sector])
  @@index([status])
  @@map("companies")
}

model Client {
  id        String       @id @default(uuid()) @db.Uuid
  firstName String       @map("first_name") @db.VarChar(80)
  lastName  String       @map("last_name") @db.VarChar(80)
  email     String       @unique @db.VarChar(255)
  phone     String?      @db.VarChar(40)
  jobTitle  String?      @map("job_title") @db.VarChar(120)
  companyId String?      @map("company_id") @db.Uuid
  status    ClientStatus @default(ACTIVE)
  notes     String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  sales         Sale[]

  @@index([lastName, firstName])
  @@index([companyId])
  @@index([status])
  @@map("clients")
}

model Opportunity {
  id                String            @id @default(uuid()) @db.Uuid
  name              String            @db.VarChar(180)
  description       String?           @db.Text
  companyId         String?           @map("company_id") @db.Uuid
  clientId          String?           @map("client_id") @db.Uuid
  ownerId           String            @map("owner_id") @db.Uuid
  value             Decimal           @db.Decimal(14, 2)
  probability       Int               @default(50)
  expectedCloseDate DateTime?         @map("expected_close_date") @db.Date
  stage             OpportunityStage  @default(PROSPECTO)
  status            OpportunityStatus @default(OPEN)
  wonAt             DateTime?         @map("won_at")
  lostAt            DateTime?         @map("lost_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner   User     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  sale    Sale?
  project Project?
  comments OpportunityComment[]
  files    OpportunityFile[]

  @@index([companyId])
  @@index([clientId])
  @@index([ownerId])
  @@index([stage])
  @@index([status])
  @@index([expectedCloseDate])
  @@map("opportunities")
}

model OpportunityFile {
  id              String   @id @default(uuid()) @db.Uuid
  opportunityId   String   @map("opportunity_id") @db.Uuid
  commentId       String?  @map("comment_id") @db.Uuid
  originalName    String   @map("original_name") @db.VarChar(255)
  storedName      String   @map("stored_name") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(120)
  size            Int
  data            Bytes    @db.ByteA
  uploadedById    String?  @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  opportunity Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  comment     OpportunityComment? @relation("OpportunityFileComment", fields: [commentId], references: [id], onDelete: SetNull)
  uploadedBy  User?               @relation("OpportunityFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([opportunityId])
  @@index([commentId])
  @@index([uploadedById])
  @@map("opportunity_files")
}

model OpportunityComment {
  id            String   @id @default(uuid()) @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  authorId      String?  @map("author_id") @db.Uuid
  body          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  opportunity Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author      User?               @relation("OpportunityCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  files       OpportunityFile[]   @relation("OpportunityFileComment")

  @@index([opportunityId, createdAt])
  @@map("opportunity_comments")
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  saleNumber    String     @unique @map("sale_number") @db.VarChar(30)
  companyId     String?    @map("company_id") @db.Uuid
  clientId      String?    @map("client_id") @db.Uuid
  opportunityId String?    @unique @map("opportunity_id") @db.Uuid
  ownerId       String     @map("owner_id") @db.Uuid
  saleDate      DateTime   @map("sale_date") @db.Date
  amount        Decimal    @db.Decimal(14, 2)
  currency      String     @default("GTQ") @db.VarChar(3)
  status        SaleStatus @default(PENDING)
  notes         String?    @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  company     Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  owner       User        @relation("SaleOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clientId])
  @@index([ownerId])
  @@index([saleDate])
  @@index([status])
  @@map("sales")
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(180)
  description   String?       @db.Text
  opportunityId String?       @unique @map("opportunity_id") @db.Uuid
  companyId     String?       @map("company_id") @db.Uuid
  managerId     String?       @map("manager_id") @db.Uuid
  phone         String?       @db.VarChar(40)
  status        ProjectStatus @default(ACTIVE)
  number        Int?          @unique
  amount        Decimal?      @map("amount") @db.Decimal(14, 2)
  currency      String        @default("GTQ") @db.VarChar(3)
  preSales      String?       @map("pre_sales") @db.VarChar(160)
  solution      String?       @db.Text
  startDate     DateTime?     @map("start_date") @db.Date
  dueDate       DateTime?     @map("due_date") @db.Date
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  manager     User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  tasks       ProjectTask[]
  files       ProjectFile[]
  comments    ProjectComment[]

  @@index([companyId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

model ProjectTask {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  title       String     @db.VarChar(180)
  description String?    @db.Text
  assigneeId  String?    @map("assignee_id") @db.Uuid
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?  @map("due_date") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@map("project_tasks")
}

model ProjectFile {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  commentId    String?  @map("comment_id") @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  size         Int
  /// Contenido binario del archivo. Se guarda en la base de datos para que
  /// sobreviva a reinicios/despliegues en hosting con disco efímero (Render).
  data         Bytes?   @db.ByteA
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment    ProjectComment? @relation("ProjectFileComment", fields: [commentId], references: [id], onDelete: SetNull)
  uploadedBy User?           @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([commentId])
  @@index([uploadedById])
  @@map("project_files")
}

model ProjectComment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?           @relation("ProjectCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  files   ProjectFile[]   @relation("ProjectFileComment")

  @@index([projectId, createdAt])
  @@map("project_comments")
}
