# Copia este archivo como backend/.env.test y usa una base de datos AISLADA.
# El script `pnpm test` aplica las migraciones y vacía las tablas entre pruebas.
NODE_ENV=test
PORT=4100
DATABASE_URL="postgresql://postgres:admin@localhost:5432/crm_test?schema=public"
APP_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY=false
SESSION_SECRET="test-only-secret-with-more-than-thirty-two-characters-123456"
SESSION_COOKIE_NAME="nexo_session"
SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=30
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
UPLOAD_DIR="uploads"
MAX_AVATAR_SIZE_MB=2
DEFAULT_CURRENCY="USD"
