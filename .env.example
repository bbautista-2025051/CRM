# ---------------------------------------------------------------------------
# Base de datos PostgreSQL (misma instancia y esquema para todos los módulos)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:admin@localhost:5432/crm_dev?schema=public"

# Base de datos aislada para pruebas de integración
TEST_DATABASE_URL="postgresql://postgres:admin@localhost:5432/crm_test?schema=public"

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"
TRUST_PROXY=false

# Secreto de 32+ caracteres usado para derivar el hash de los tokens de sesión.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="REEMPLAZA_ESTO_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"
SESSION_COOKIE_NAME="nexo_session"

# ---------------------------------------------------------------------------
# JWT (JSON Web Tokens) - autenticación por Bearer token para APIs
# ---------------------------------------------------------------------------
# Clave secreta para firmar y verificar tokens JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REEMPLAZA_ESTO_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"
# Expiración del token JWT (ej: 1h, 7d, 30d). Usa unidades aceptadas por ms.
JWT_EXPIRES_IN="7d"
# Duración de una sesión sin "Recuérdame" (horas)
SESSION_TTL_HOURS=8
# Duración de una sesión con "Recuérdame" (días)
SESSION_REMEMBER_DAYS=30
# Fuerza cookies Secure. En producción debe ser true (HTTPS obligatorio).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Google OAuth / OpenID Connect (opcional)
# ---------------------------------------------------------------------------
# Si se deja vacío, el botón de Google no se muestra y la función queda deshabilitada.
# No se permite el auto-registro: solo usuarios internos con google_id ya vinculado.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Carga de archivos (avatares)
# ---------------------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_AVATAR_SIZE_MB=2

# Moneda base para los importes de oportunidades y los totales del dashboard.
DEFAULT_CURRENCY="GTQ"

# ---------------------------------------------------------------------------
# Primer administrador (solo lo usa el script create-admin)
# No uses estas variables para el seed de demostración.
# ---------------------------------------------------------------------------
ADMIN_NAME="Administrador"
ADMIN_EMAIL="mendoza.deleon.elias.ottoniel@gmail.com"
ADMIN_PASSWORD="123456789Aa"

# ---------------------------------------------------------------------------
# Seed de demostración (opcional). Solo se ejecuta con `pnpm db:seed`.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Frontend (Vite). Copia este bloque a frontend/.env si necesitas cambiarlo.
# ---------------------------------------------------------------------------
VITE_API_URL=""
VITE_COMPANY_NAME="Nexo"
VITE_CRM_NAME="Nexo CRM"
# URL o ruta del logo corporativo. Si está vacío se usa el monograma provisional.
VITE_LOGO_URL=""
